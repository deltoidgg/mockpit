{
  "name": "mockpit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "MockPit: see what is still mock, watch it become real.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deltoidgg/mockpit.git"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "corepack pnpm --filter mockpit build",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "dev": "corepack pnpm --filter @mockpit/example-react-msw dev",
    "dev:cafe": "corepack pnpm --filter @mockpit/example-foldkit-cafe dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "jsdom": "^27.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "5.1.0"
  }
}
